ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# PostgreSQL (local Docker or Railway ConnectionStrings__DefaultConnection)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=virtualmuseum;Username=postgres;Password=postgres

# Railway (on Heroku): use DATABASE_PUBLIC_URL from Railway → Variables (not postgres.railway.internal).
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
# DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway

# JWT
Jwt__Key=VirtualMuseum-SuperSecretKey-ForJwtTokenGeneration-Minimum32Chars!
Jwt__Issuer=VirtualMuseum.API
Jwt__Audience=VirtualMuseum.Client
Jwt__AccessTokenMinutes=60
Jwt__RefreshTokenDays=7

# SMTP
Smtp__Enabled=false
Smtp__SmtpServer=smtp.example.com
Smtp__Port=587
Smtp__SenderName=Virtual Museum
Smtp__SenderEmail=no-reply@example.com
Smtp__Username=
Smtp__Password=

# CORS (comma-separated origins or indexed keys)
Cors__Origins__0=http://localhost:3000
Cors__Origins__1=https://localhost:3000

# Google Auth
GoogleAuth__ClientId=

# Community image uploads (Cloudinary only — signed upload via API key + secret)
EGY_UPLOAD_STORAGE=cloudinary
Upload__Storage=cloudinary
Cloudinary__CloudName=dwh3jp5vp
Cloudinary__ApiKey=
Cloudinary__ApiSecret=
Cloudinary__Folder=egy
# Optional unsigned fallback (create preset in Cloudinary dashboard first)
# Cloudinary__UploadPreset=egy_community
